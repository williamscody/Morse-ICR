<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- RECORD_AUDIO and BLUETOOTH_CONNECT (speech_to_text's own
         Bluetooth SCO switching) previously lived here for Speech
         Recognition, removed 2026-09-11 now that Speech Recognition is
         permanently disabled on Android (iOS-only, see
         TrainingScreen._recognitionEnabled and
         [[project_android_bluetooth_recognition]] project memory: a real
         transcription-accuracy ceiling for rapid single-character
         speech, not a fixable bug). Neither permission is needed for
         anything else this app does, and dropping them simplifies the
         Play Store listing (Data Safety form, permission review) ahead
         of first submission, since no microphone access is ever
         requested on Android at all now.

         just_audio: playing a local/generated audio source routes through
         ExoPlayer via just_audio's own loopback HTTP proxy on
         127.0.0.1, which needs INTERNET to open a socket at all.
         Confirmed on-device (Moto G Play, 2024): without this, every
         playTurn call failed with SocketException "Operation not
         permitted" trying to bind that proxy, so no audio ever played. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- audio_service (section 42, Android background audio): a training
         session must keep advancing while the screen is locked, which on
         Android requires a real foreground service rather than iOS's
         continuous-audio background grant. WAKE_LOCK/FOREGROUND_SERVICE are
         audio_service's own documented requirements;
         FOREGROUND_SERVICE_MEDIA_PLAYBACK is mandatory (not just
         recommended) once targeting SDK 34+, which this app already does;
         POST_NOTIFICATIONS is the Android 13+ runtime-requested permission
         the foreground service's own notification needs to actually be
         visible (see notification_permission.dart). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Morse ICR Trainer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- audio_service's own foreground service, hosting the single
             Flutter engine MainActivity now shares with it (see
             AudioServiceActivity below), which is what keeps
             TrainingEngine's turn-to-turn Timer running once the screen
             locks and MainActivity itself is gone. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Routes the lock-screen/notification Play/Pause tap (and
             hardware media-button presses) to TrainingAudioHandler's
             play()/pause() overrides. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
